{
  "name": "@sourcetoad/react-native-sketch-canvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sourcetoad/react-native-sketch-canvas.git"
  },
  "version": "3.1.0",
  "description": "react-native-sketch-canvas allows you to draw / sketch on both iOS and Android devices and sync the drawing data between users. Of course you can save as image.",
  "author": "Terry Lin",
  "react-native": "./src/index.tsx",
  "source": "./src/index.tsx",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/module/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "react-native": "./src/index.tsx",
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "react-native": "./src/index.tsx",
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    }
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "nitrogen",
    "nitro.json",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "cd example && npm i",
    "example:android": "cd example && npm run android",
    "example:ios": "cd example && npm run ios",
    "test": "jest",
    "typescript": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "build": "bob build && node scripts/copy-nitro-config.mjs",
    "pods": "cd example/ios && bundle install && bundle exec pod install && cd ../..",
    "prepare": "npm run build",
    "nitrogen": "nitrogen"
  },
  "keywords": [
    "react-native",
    "react-native-sketch",
    "react-native-svg",
    "react",
    "native",
    "sketch",
    "svg",
    "draw"
  ],
  "nativePackage": true,
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sourcetoad/react-native-sketch-canvas/issues"
  },
  "homepage": "https://github.com/sourcetoad/react-native-sketch-canvas",
  "devDependencies": {
    "@react-native-community/cli": "20.2.0",
    "@react-native/babel-preset": "^0.87.1",
    "@react-native/jest-preset": "^0.87.1",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.1.0",
    "del-cli": "^5.1.0",
    "jest": "^29.7.0",
    "nitrogen": "0.37.1",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-builder-bob": "^0.37.0",
    "react-native-nitro-modules": "0.37.1",
    "react-test-renderer": "19.2.3",
    "turbo": "^2.9.14",
    "typescript": "^5.8.3"
  },
  "resolutions": {
    "@types/react": "^19.2.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.86",
    "react-native-nitro-modules": "~0.37.1"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/src/__tests__/setup/jest-setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|@react-native-community|@react-native/js-polyfills|react-native-nitro-modules)/)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/__tests__/setup/jest-setup.js"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "custom",
        {
          "script": "nitrogen",
          "clean": "nitrogen/"
        }
      ],
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json",
          "esm": true
        }
      ]
    ]
  },
  "create-react-native-library": {
    "languages": "kotlin-objc",
    "type": "view-new",
    "version": "0.44.3"
  }
}
