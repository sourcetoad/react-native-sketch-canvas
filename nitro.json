{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["sketchcanvas"],
  "ios": {
    "iosModuleName": "RNSketchCanvas"
  },
  "android": {
    "androidNamespace": ["sketchcanvas"],
    "androidCxxLibName": "RNSketchCanvasNitro"
  },
  "autolinking": {
    "SketchCanvasView": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridSketchCanvasView"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridSketchCanvasView"
      }
    },
    "SketchCanvasConstants": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridSketchCanvasConstants"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridSketchCanvasConstants"
      }
    }
  },
  "ignorePaths": ["node_modules", "lib", "example"]
}
